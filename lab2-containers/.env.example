# Скопіюйте у .env і заповніть: cp .env.example .env
# Файл .env не комітиться (він у .gitignore).

POSTGRES_USER=autoslot
POSTGRES_PASSWORD=change-me            # будь-який довгий випадковий рядок
GATEWAY_PORT=8080
HOLD_TTL_SECONDS=300
REPLICAS=2                             # кількість реплік кожного сервісу

# --- авторизація ---
# Секрет для підпису JWT, щонайменше 16 символів, однаковий для всіх реплік.
# Згенерувати: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET=change-me-to-a-long-random-string
ADMIN_EMAILS=admin@example.com         # через кому; ці адреси отримують роль ADMIN
COOKIE_SECURE=false                    # true, коли сайт працює по HTTPS
AUTH_DEV_MODE=true                     # true: без SMTP код входу показується на сторінці. У хмарі — false!

# --- пошта (необов'язково) ---
# Без SMTP_HOST листи лише пишуться в журнал контейнерів (docker compose logs auth).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=ваша адреса, SMTP_PASSWORD=пароль застосунку.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=AutoSlot <no-reply@autoslot.local>

# --- моніторинг (ЛР4, профіль monitoring) ---
GRAFANA_PASSWORD=change-me             # пароль користувача admin у Grafana
GRAFANA_PORT=3000
